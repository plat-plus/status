# Served by Hetzner Webhosting (Apache). Copied to _site/.htaccess by build.mjs.

# HTTPS only.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://status.plat.plus%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "DENY"
	Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

	# The page changes with every check: browsers ask again each time.
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	<FilesMatch "\.(css|svg|woff2)$">
		Header set Cache-Control "public, max-age=86400"
	</FilesMatch>
</IfModule>

Options -Indexes
